#!/bin/sh
# Pre-push guard for inline SVGs (geometry / animation-ref / regression lint).
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass in an emergency:  git push --no-verify
echo "running scripts/check-svgs.py ..."
python scripts/check-svgs.py || {
  echo "check-svgs failed — push aborted. Fix the SVG errors above (or --no-verify to override)."
  exit 1
}
